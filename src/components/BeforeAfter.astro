---
/**
 * Curseur avant/après. Fonctionne avec de vraies photos ou avec les
 * emplacements « photo à venir » de la démo.
 * Les deux images doivent avoir le même cadrage et le même ratio.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  before?: ImageMetadata;
  after?: ImageMetadata;
  /** Description de la pièce, ex. « Salon, appartement haussmannien, Paris 16e ». */
  subject: string;
  ratio?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { before, after, subject, ratio = '4 / 3', sizes, loading = 'lazy' } = Astro.props;
---

<div class="ba" data-ba style="--pos: 50%">
  <div class="ba-layer">
    <Photo image={after} alt={`Après travaux : ${subject}`} label={`après, ${subject}`} tone="apres" labelAlign="right" ratio={ratio} sizes={sizes} loading={loading} />
  </div>
  <div class="ba-layer ba-before" aria-hidden="true">
    <Photo image={before} alt={`Avant travaux : ${subject}`} label={`avant, ${subject}`} tone="avant" ratio={ratio} sizes={sizes} loading={loading} />
  </div>
  <span class="ba-tag ba-tag-before" aria-hidden="true">Avant</span>
  <span class="ba-tag ba-tag-after" aria-hidden="true">Après</span>
  <span class="ba-handle" aria-hidden="true"></span>
  <input
    class="ba-range"
    type="range"
    min="0"
    max="100"
    value="50"
    aria-label={`Comparer avant et après : ${subject}`}
    data-umami-event="usage-avant-apres"
  />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.ba-range');
    if (!range) return;
    const update = () => el.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', update);
    update();
  });
</script>

<style>
  .ba {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    user-select: none;
    touch-action: pan-y;
  }

  .ba-layer {
    display: block;
  }

  .ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba-before :global(.photo) {
    height: 100%;
  }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--platre);
    box-shadow: 0 0 0 1px rgba(30, 36, 40, 0.18);
    pointer-events: none;
  }

  .ba-handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.75rem;
    height: 2.75rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--platre);
    border: 1px solid var(--ardoise);
    background-image:
      linear-gradient(135deg, transparent 46%, var(--ardoise) 46% 54%, transparent 54%),
      linear-gradient(45deg, transparent 46%, var(--ardoise) 46% 54%, transparent 54%);
    background-size: 0.55rem 0.55rem;
    background-position: 30% 50%, 70% 50%;
    background-repeat: no-repeat;
  }

  .ba-tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.8rem;
    font-weight: 600;
    background: color-mix(in srgb, var(--platre) 88%, transparent);
    color: var(--ardoise);
    border-radius: var(--radius);
    pointer-events: none;
  }

  .ba-tag-before {
    left: 0.75rem;
  }

  .ba-tag-after {
    right: 0.75rem;
  }

  /* Le curseur natif couvre toute l'image : glisser n'importe où fonctionne */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .ba:has(.ba-range:focus-visible) .ba-handle::after {
    outline: 2px solid var(--laiton);
    outline-offset: 2px;
  }
</style>
