---
/**
 * Appel à l'action de fin de page, présent partout.
 */
import ContactButtons from './ContactButtons.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { phoneLink } from '../lib/contact';

interface Props {
  title?: string;
  text?: string;
  whatsappMessage?: string;
  tracking?: string;
}

const {
  title = 'Parlons de votre projet',
  text = `Décrivez-nous votre appartement et vos envies. Nous vous rappelons ${site.contact.responseDelay} pour organiser une visite sur place.`,
  whatsappMessage,
  tracking = 'fin-de-page',
} = Astro.props;
---

<section class="section section-vert cta">
  <div class="container-site cta-grid">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta-actions">
      <ContactButtons variant="dark" whatsappMessage={whatsappMessage} tracking={tracking} />
      <a href={phoneLink} class="cta-phone" data-umami-event={`clic-telephone-${tracking}`}>
        <Icon name="phone" />
        <span>{site.contact.phoneDisplay}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-grid {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  @media (min-width: 900px) {
    .cta-grid {
      grid-template-columns: 1.3fr 1fr;
      gap: 4rem;
    }
  }

  .cta .lead {
    margin-top: 1rem;
  }

  .cta-actions {
    display: grid;
    gap: 1.25rem;
  }

  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--ff-display);
    font-size: 1.6rem;
    text-decoration: none;
    color: var(--platre);
  }

  .cta-phone :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--laiton);
  }
</style>
