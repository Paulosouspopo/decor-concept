---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import ProjectFacts from '../../components/ProjectFacts.astro';
import Photo from '../../components/Photo.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { projectTypeLabels } from '../../lib/format';
import { whatsappMessages } from '../../lib/contact';

export async function getStaticPaths() {
  const projects = await getCollection('realisations');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'realisations'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const zone = data.zone ? await getEntry('zones', data.zone) : undefined;
const others = (await getCollection('realisations'))
  .filter((p) => p.id !== project.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const waMessage = whatsappMessages.realisation(data.title);
const subject = `${data.location}, ${data.surface} m²`;
---

<BaseLayout
  title={`${data.title}, ${data.location}`}
  description={data.summary}
  whatsappMessage={waMessage}
>
  <PageHero
    title={data.title}
    lead={data.summary}
    crumbs={[
      { name: 'Réalisations', href: '/realisations/' },
      { name: data.location, href: `/realisations/${project.id}/` },
    ]}
  />

  {
    data.fictif && (
      <div class="container-site">
        <p class="fictif-note">
          <span class="tag-exemple">Exemple</span> Cette réalisation illustre la démonstration du site. Elle sera remplacée
          par un chantier réel.
        </p>
      </div>
    )
  }

  <section class="section">
    <div class="container-site project-top">
      <BeforeAfter before={data.before} after={data.after} subject={subject} ratio="3 / 2" sizes="(min-width: 1024px) 60vw, 100vw" loading="eager" />
      <ProjectFacts project={project} />
    </div>
  </section>

  <section class="section section-pierre">
    <div class="container-site story">
      <div class="prose-site">
        <Content />
      </div>
      <aside class="story-aside">
        <p class="meta">Travaux concernés</p>
        <ul>
          {
            data.services.map((s) => (
              <li>
                <a href={`/renovation/${s}/`} class="link">
                  {projectTypeLabels[s]}
                </a>
              </li>
            ))
          }
        </ul>
        {
          zone && (
            <>
              <p class="meta aside-zone">Secteur</p>
              <a href={`/zones/${zone.id}/`} class="link">
                Nos chantiers à {zone.data.name}
              </a>
            </>
          )
        }
      </aside>
    </div>
  </section>

  {
    data.gallery.length > 0 ? (
      <section class="section">
        <div class="container-site gallery">
          {data.gallery.map((item) => (
            <Photo image={item.src} alt={item.alt} ratio="3 / 2" sizes="(min-width: 900px) 50vw, 100vw" />
          ))}
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container-site gallery">
          <Photo alt={`Détail du chantier, ${data.location}`} label="détail des finitions" ratio="3 / 2" />
          <Photo alt={`Vue d'ensemble, ${data.location}`} label="vue d'ensemble" tone="neutre" ratio="3 / 2" />
        </div>
      </section>
    )
  }

  {
    data.testimonial && (
      <section class="section section-pierre">
        <div class="container-site">
          <figure class="quote">
            {data.testimonial.fictif && <span class="tag-exemple">Exemple, à remplacer</span>}
            <blockquote>{data.testimonial.text}</blockquote>
            <figcaption class="meta">{data.testimonial.author}, {data.location}</figcaption>
          </figure>
        </div>
      </section>
    )
  }

  {
    others.length > 0 && (
      <section class="section">
        <div class="container-site">
          <h2 class="others-title">D'autres réalisations</h2>
          <div class="others">
            {others.map((p) => <ProjectCard project={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBlock title="Un projet comparable ?" whatsappMessage={waMessage} tracking="fin-realisation" />
</BaseLayout>

<style>
  .fictif-note {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--gris);
  }

  .project-top {
    display: grid;
    gap: 2rem;
  }

  .story {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .story {
      grid-template-columns: 1fr 16rem;
      gap: 5rem;
    }
  }

  .story-aside ul {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.4rem;
  }

  .aside-zone {
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
  }

  .gallery {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
  }

  .quote {
    max-width: 48rem;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .quote blockquote {
    font-family: var(--ff-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem);
    line-height: 1.3;
  }

  .others-title {
    margin-bottom: 2.5rem;
  }

  .others {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .others {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
