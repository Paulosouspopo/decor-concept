# Copier ce fichier en .env pour le développement local.
# Sur Cloudflare Pages, déclarer les mêmes variables dans
# Settings > Environment variables (Production et Preview).

# Clé d'accès Web3Forms (https://web3forms.com), liée à l'email qui reçoit les demandes.
# Vide = le formulaire reste en mode démonstration (aucun envoi).
PUBLIC_WEB3FORMS_KEY=

# Mesure d'audience Umami (optionnel). Vide = aucun script chargé.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
